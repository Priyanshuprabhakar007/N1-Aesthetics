# ==============================================================================
# N7 AESTHETICS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real secret values or private keys to Git.
# - Variables prefixed with `VITE_` are bundled into the public browser client.
# - NEVER prefix Firebase Admin SDK credentials (`FIREBASE_ADMIN_*` or
#   `FIREBASE_SERVICE_ACCOUNT_JSON`) with `VITE_`.
# ==============================================================================

# 1. PUBLIC FRONTEND FIREBASE CONFIGURATION (Safe for browser bundle)
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0746984388"
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0746984388.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-n7aestheticsdrna-4af226be-e1d4-4376-b096-04af18ed7a92"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0746984388.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# 2. SERVER-ONLY FIREBASE ADMIN SDK CREDENTIALS (Required in production for /api/appointments)
# Used exclusively by /api/appointments.ts on the server to authenticate with Firestore,
# verify saved appointment_enquiries/{enquiryId} documents, enforce atomic notification
# idempotency (appointment_notification_locks), and run distributed rate limiting.
# Provide EITHER `FIREBASE_SERVICE_ACCOUNT_JSON` (full JSON or base64-encoded JSON)
# OR the three `FIREBASE_ADMIN_*` variables below:
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_ADMIN_PROJECT_ID="gen-lang-client-0746984388"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-n7aestheticsdrna-4af226be-e1d4-4376-b096-04af18ed7a92"

# 3. APPLICATION ORIGIN & OPTIONAL STAFF NOTIFICATION WEBHOOK (Server-only)
# APP_URL: Public canonical origin used for strict Origin validation on POST /api/appointments.
APP_URL="https://your-domain.vercel.app"

# NOTIFICATION_WEBHOOK_URL: Optional privacy-safe webhook endpoint.
# Dispatches ONLY verified Firestore metadata (enquiryId, treatment, preferredDate, submittedAt)
# after server-side Firebase Admin verification of appointment_enquiries/{enquiryId}.
NOTIFICATION_WEBHOOK_URL=""

# 4. DISTRIBUTED SERVERLESS RATE LIMITING (Server-only)
# Recommended for multi-instance Vercel deployments. If Upstash is not configured,
# /api/appointments falls back to a distributed Firestore transaction via Firebase Admin SDK,
# and fails closed in production if no distributed rate limiter is available.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 5. OPTIONAL AI STUDIO RUNTIME KEY (Not used in public client code)
GEMINI_API_KEY=""
