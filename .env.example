# GEMINI_API_KEY: Optional in AI Studio runtime (not used in public client code).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="https://your-domain.vercel.app"

# OPTIONAL SERVER-SIDE WEBHOOK NOTIFICATION (Serverless /api/appointments only — never exposed to client)
# Leave empty if not configured. When set to a privacy-compliant webhook endpoint, /api/appointments
# dispatches non-PII consultation enquiry alerts (treatment & preferredDate only; no patient name/phone/email/notes).
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_RECIPIENT_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
